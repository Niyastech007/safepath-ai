# SafePath AI - Environment Variables Configuration
# Copy this file to .env for production overrides

# Server Configuration
PORT=5000
HOST=0.0.0.0
FLASK_DEBUG=False

# Geospatial & Weather Services
# Open-Meteo is 100% open-source & keyless for hackathons
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_SECONDS=600

# Geographic Center (Tiruchirappalli, Tamil Nadu)
TRICHY_LAT=10.7905
TRICHY_LNG=78.7047

# Database Path (defaults to safepath.db in working directory)
SQLITE_DB_PATH=safepath.db

# Hackathon Metadata
HACKATHON_NAME=HACKWELL 2.0
COLLEGE_NAME=Saranathan College of Engineering, Tiruchirappalli
TRACK=HCA-05 Smart Cities (Human-Centered AI)
